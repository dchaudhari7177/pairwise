# Copy to .env.local for local overrides. With nothing set, the app runs on an
# in-memory store (persisted to .data/db.json) seeded with the demo scenario.

# Required in production: a long random string used to sign session cookies.
SESSION_SECRET=

# Firestore service account JSON (raw JSON or base64). When set, the app uses Firestore.
FIREBASE_SERVICE_ACCOUNT=

# Vercel Cron sends this as a Bearer token to /api/cron/reset-demo.
CRON_SECRET=

# Public base URL (used for metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
